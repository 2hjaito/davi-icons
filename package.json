{
  "name": "davi-icons",
  "private": true,
  "workspaces": [
    "apps/*",
    "package"
  ],
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "turbo run build",
    "icons:sync": "tsx scripts/build.ts",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter web dev",
    "publish:pkg": "pnpm -C package publish --access public --no-git-checks"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/svg-parser": "^2.0.6",
    "fast-glob": "^3.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svg-parser": "^2.1.0",
    "svgo": "^3.3.5",
    "tsx": "^4.19.2",
    "turbo": "^2.10.12",
    "typescript": "^5.8.3"
  }
}