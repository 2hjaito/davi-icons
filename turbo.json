{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "//#icons:sync": {
      "cache": false,
      "outputs": [
        "package/icons/**",
        "apps/web/public/metadata.json",
        "apps/web/app/icons/packs.generated.ts"
      ]
    },
    "build": {
      "dependsOn": [
        "^build",
        "//#icons:sync"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "lint": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    }
  }
}