{
  "name": "davi-icons",
  "version": "0.1.4",
  "description": "Framework-agnostic icon platform with 35,000+ tree-shakeable icons for React and Next.js",
  "type": "module",
  "author": "tranhuudang",
  "license": "MIT",
  "keywords": [
    "react",
    "react-icons",
    "icons",
    "nextjs",
    "svg",
    "svg-icons",
    "feather-icons",
    "font-awesome",
    "material-design",
    "lucide",
    "tree-shakeable",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2hjaito/davi-icons.git",
    "directory": "package"
  },
  "bugs": {
    "url": "https://github.com/2hjaito/davi-icons/issues"
  },
  "homepage": "https://github.com/2hjaito/davi-icons#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
